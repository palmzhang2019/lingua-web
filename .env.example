# Lingua Web — Environment Configuration
# Copy this file to .env and fill in your actual API keys.
# .env is gitignored — never commit real keys.
#
# ===== DeepSeek (TXT/MD extraction, study cycles) =====
DEEPSEEK_API_KEY="sk-your..."
#
# ===== OpenAI Platform (PDF vision analysis) =====
# Model gpt-5.4-mini is used for PDF page understanding.
# Key must be an OpenAI Platform API key.
# Selected PDF pages (max 3, max 10 MB) are sent to OpenAI API.
OPENAI_API_KEY="sk-proj-your..."
